{
  "name": "puzzlescriptnext",
  "private": true,
  "description": "PuzzleScript Next - the fortress-rhythm fork, with the palette set and the map editor",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "node puzzlescript-map-editor/src/serve.js --root . --port 8020",
    "test": "node puzzlescript-map-editor/test/run.js",
    "check:games": "node puzzlescript-map-editor/src/cli.js check src/demo/*.txt",
    "check:palettes": "uv run tools/palette_test.py",
    "check:export": "node tools/inline_standalone.js --check",
    "build:template": "node tools/inline_standalone.js",
    "build": "node compile.js"
  },
  "dependencies": {
    "compress-images": "^2.0.5",
    "concat": "^1.0.3",
    "gifsicle": "^5.3.0",
    "glob": "^8.1.0",
    "gzipper": "^7.2.0",
    "html-minifier-terser": "^7.2.0",
    "ncp": "^2.0.0",
    "rimraf": "^3.0.2",
    "terser": "^5.17.1",
    "web-resource-inliner": "^6.0.1",
    "ycssmin": "^1.0.1"
  }
}
